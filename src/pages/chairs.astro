
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Committee Chairs">

  <main class="placeholder-page">

    <div class="placeholder-banner">
      <span class="section-label">ZAGAMUN 2026</span>

      <h1>Info will be updated shortly</h1>

      <div class="title-divider"></div>

      <p>
        Please check back soon for committee chair info.
      </p>
    </div>

  </main>

</Layout>

<style>
  .placeholder-page {
    min-height: 75vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem 1.5rem;
    color: #ffffff;
  }

  .placeholder-banner {
    width: 100%;
    max-width: 850px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 3.5rem 3rem;
    text-align: center;
  }

  .section-label {
    display: block;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 3px;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .placeholder-banner h1 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .title-divider {
    width: 65px;
    height: 3px;
    background: #ffffff;
    margin: 1.5rem auto;
    border-radius: 5px;
  }

  .placeholder-banner p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  @media (max-width: 700px) {
    .placeholder-page {
      min-height: 70vh;
      padding: 2rem 1.25rem;
    }

    .placeholder-banner {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
