
---
import Layout from "../layouts/Layout.astro";

const committees = [
  {
    name: "Disarmament & International Security",
    headChair: "Jamie Cass - Gonzaga College",
    coChairs: ["Daniel Egan - Terenure College", "Hannah Barcroft - St. Andrew's College"]
  },
  {
    name: "Social & Humanitarian",
    headChair: "Max Kelly Bowen - Gonzaga College",
    coChairs: ["Juliet Trenaman - Loreto College St. Stephen's Green", "Luke French - St. Andrew's College"]
  },
  {
    name: "Ecology & Environment",
    headChair: "Jamie Flannery - Gonzaga College",
    coChairs: ["Ben Cunningham - Terenure College", "Izzy Jackson - Wesley College"]
  },
  {
    name: "Economics & Finance",
    headChair: "Hugh Quinlan - Gonzaga College",
    coChairs: ["Roz Waghorn - The High School", "Charlie Martin - Terenure College"]
  },
  {
    name: "Health & Youth",
    headChair: "Oscar MacCallum - Gonzaga College",
    coChairs: ["Ace Costello Tyrrell - Alexandra College", "Martina Moran - The Teresian School"]
  },
  {
    name: "Special Politics & Decolonisation",
    headChair: "Daniel Cahill - Gonzaga College",
    coChairs: ["Beth Dooley - Muckross", "Noah Broderick/Darragh O'Brien - Gonzaga College"]
  },
  {
    name: "Security Council",
    headChair: "Mark Conway - Gonzaga College",
    coChairs: ["Ava Brennan - Wesley College", "James Cunnane/Conor Sheahan - Gonzaga College"]
  }
];
---

<Layout title="Committee Chairs">

  <main class="chairs-page">

    <section class="page-intro">
      <span class="section-label">ZAGAMUN 2026</span>
      <h1>Committee Chairs</h1>
      
    </section>

    <section class="committee-grid">

      {committees.map((committee) => (
        <article class="committee-card">

          <div class="committee-heading">
            <h2>{committee.name}</h2>
          </div>

          <div class="title-divider"></div>

          <div class="chair-list">

            <div class="chair-item">
              <span class="chair-role">Head Chair</span>
              <span class="chair-name">{committee.headChair}</span>
            </div>

            {committee.coChairs.map((chair, index) => (
              <div class="chair-item">
                <span class="chair-role">Co-Chair {index + 1}</span>
                <span class="chair-name">{chair}</span>
              </div>
            ))}

          </div>

        </article>
      ))}

    </section>

  </main>

</Layout>

<style>
  /* PAGE */
  .chairs-page {
    width: 90%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 5rem 0 6rem;
    color: #ffffff;
  }

  /* INTRODUCTION */
  .page-intro {
    margin-bottom: 2.5rem;
  }

  .section-label {
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
    font-weight: bold;
    letter-spacing: 3px;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .page-intro h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .page-intro p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 1);
    margin: 1rem 0 0;
  }

  /* COMMITTEE GRID */
  .committee-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  /* COMMITTEE CARDS */
  .committee-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: background 0.2s ease;
  }

  .committee-card:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  /* HEADING */
  .committee-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }

  .committee-heading h2 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    line-height: 1.3;
    margin: 0;
    color: #ffffff;
  }

  /* DIVIDER */
  .title-divider {
    width: 65px;
    height: 3px;
    background: #ffffff;
    margin: 1.5rem 0;
    border-radius: 5px;
  }

  /* CHAIRS */
  .chair-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .chair-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .chair-role {
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .chair-name {
    font-size: 1.05rem;
    line-height: 1.5;
    color: #ffffff;
  }

  /* MOBILE */
  @media (max-width: 700px) {
    .chairs-page {
      width: 90%;
      padding: 3rem 0 4rem;
    }

    .committee-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .committee-card {
      padding: 2rem 1.5rem;
    }

    .page-intro h1 {
      font-size: 2rem;
    }
  }
</style>
</Layout>
