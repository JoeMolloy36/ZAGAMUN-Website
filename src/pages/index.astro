
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ZAGAMUN 2026">
  <main>
    <img
      class="center-logo"
      src="/IMG_0633.jpeg"
      alt="ZAGAMUN logo"
    />

    <h1>ZAGAMUN 2026</h1>

    <p>
      A Model United Nations conference bringing together delegates
      to debate global issues, develop diplomatic skills and shape
      solutions through collaboration.
    </p>
  </main>

  <style>
    main {
      min-height: 75vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: 15px;
      padding: 2rem 1.5rem;
    }

    .center-logo {
      width: 280px;
      height: 280px;
      object-fit: contain;
      margin-bottom: 5px;
    }

    h1 {
      font-size: clamp(3rem, 8vw, 6rem);
      margin: 0;
      color: #ffffff;
      letter-spacing: 2px;
    }

    p {
  max-width: 750px;
  font-size: clamp(1.3rem, 3vw, 2rem);
  line-height: 1.4;
  margin: 60px 0 0;
  color: #ffffff;
}

    @media (max-width: 600px) {
      main {
        min-height: 70vh;
        padding: 2rem 1.25rem;
        gap: 12px;
      }

      .center-logo {
        width: 190px;
        height: 190px;
      }

      h1 {
        font-size: clamp(2.5rem, 11vw, 4rem);
      }

      p {
        font-size: 1.3rem;
      }
    }
  </style>
</Layout>
