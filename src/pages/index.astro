
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <main>
    <!-- Hero section -->
    <section class="hero">
      <div class="hero-content">
        <img
          class="center-logo"
          src="/logocircle.png"
          alt="ZAGAMUN logo"
        />

        <h1>ZAGAMUN 2026</h1>

        <p class="intro">
          27th & 28th November
        </p>
      </div>
    </section>

    <!-- Description section -->
    <section class="description">
      <div class="description-content">

        <!-- Text card -->
        <div class="description-card">
          <span class="section-label">ABOUT THE CONFERENCE</span>

          <h2>Welcome to ZAGAMUN 2026</h2>

          <div class="title-divider"></div>

          <p>
            ZAGAMUN brings together delegates from across Dublin
            to debate, strategise and collaborate on international
            issues.
          </p>

          <p>
            We welcome all delegates to our second conference this November to
            join us for a thrilling weekend of fruitful debate across our 7 committees.
          </p>

          
        </div>

        <!-- Image -->
        <div class="description-image">
          <img
            src="/conference.jpg"
            alt="ZAGAMUN conference"
          />
        </div>

      </div>
    </section>
  </main>

  <style>
    main {
      padding: 0;
    }

    /* HERO SECTION */
    .hero {
      min-height: 90vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 3rem 1.5rem;

      background-image:
        linear-gradient(
          rgba(0, 0, 0, 0.4),
          rgba(0, 0, 0, 0.55)
        ),
        url("/background.jpg");

      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      max-width: 900px;
    }

    .center-logo {
      width: 340px;
      height: 340px;
      object-fit: contain;
      margin-bottom: 5px;
    }

    h1 {
      font-size: clamp(2rem, 8vw, 4rem);
      margin: 0;
      color: #ffffff;
      letter-spacing: 2px;
    }

    .intro {
      max-width: 750px;
      font-size: clamp(1.3rem, 3vw, 2rem);
      line-height: 1.4;
      margin: 10px 0 0;
      color: #ffffff;
    }

    /* DESCRIPTION SECTION */
    .description {
      padding: 6rem 2rem;
      color: #ffffff;
    }

    .description-content {
      max-width: 1150px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: stretch;
    }

    /* TEXT CARD */
    .description-card {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      padding: 3rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: left;
    }

    .section-label {
      font-size: 0.8rem;
      font-weight: bold;
      letter-spacing: 3px;
      color: #ffffff;
      margin-bottom: 1rem;
    }

    .description-card h2 {
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      line-height: 1.2;
      margin: 0;
    }

    .title-divider {
      width: 65px;
      height: 3px;
      background: #d6b77a;
      margin: 1.5rem 0;
      border-radius: 5px;
    }

    .description-card p {
      font-size: 1.1rem;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.85);
      margin: 0 0 1.2rem;
    }

    .description-card p:last-child {
      margin-bottom: 0;
    }

    /* IMAGE */
    .description-image {
      min-height: 400px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .description-image img {
      width: 100%;
      height: 100%;
      min-height: 400px;
      object-fit: cover;
      display: block;
    }

    /* MOBILE */
    @media (max-width: 700px) {
      .hero {
        min-height: 85vh;
        padding: 2rem 1.25rem;
      }

      .center-logo {
        width: 220px;
        height: 220px;
      }

      h1 {
        font-size: clamp(2.5rem, 11vw, 4rem);
      }

      .intro {
        font-size: 1rem;
      }

      .description {
        padding: 3rem 1.25rem;
      }

      .description-content {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .description-card {
        padding: 2rem 1.5rem;
      }

      .description-image {
        min-height: 250px;
      }

      .description-image img {
        min-height: 250px;
        max-height: 350px;
      }
    }
  </style>
</Layout>
