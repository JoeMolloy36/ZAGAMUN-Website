
---
import Layout from "../layouts/Layout.astro";

const committees = [
  {
    name: "Security Council",
    headChair: "Joe Bloggs",
    topics: [
      "TQO Treaty Erosion",
      "South China Sea",
      "Red Sea Crisis"
    ]
  },
  {
    name: "DISEC",
    headChair: "Jane Smith",
    topics: [
      "Autonomous Weapons",
      "Drone Regulation",
      "Nuclear Proliferation"
    ]
  },
  {
    name: "General Assembly",
    headChair: "John Murphy",
    topics: [
      "International Cooperation",
      "Global Development",
      "Human Rights"
    ]
  }
];
---

<Layout title="Topics | ZAGAMUN">

  <main class="topics-page">

    <section class="page-intro">
      <span class="section-label">ZAGAMUN 2026</span>
      <h1>Conference Topics</h1>
      <p>
        Explore the committees and topics being discussed
        at this year's conference.
      </p>
    </section>

    <section class="committee-grid">

      {committees.map((committee) => (
        <article class="committee-card">

          <span class="section-label">COMMITTEE</span>

          <div class="committee-heading">
            <h2>{committee.name}</h2>
            <span class="head-chair">
              Head Chair: {committee.headChair}
            </span>
          </div>

          <div class="title-divider"></div>

          <div class="topic-list">
            {committee.topics.map((topic, index) => (
              <div class="topic-item">
                <span class="topic-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="topic-name">{topic}</span>
              </div>
            ))}
          </div>

        </article>
      ))}

    </section>

  </main>

</Layout>

<style>
  /* PAGE */
  .topics-page {
    width: 90%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 5rem 0 6rem;
    color: #ffffff;
  }

  /* INTRODUCTION */
  .page-intro {
    margin-bottom: 2.5rem;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 3px;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .page-intro h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .page-intro p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 1);
    margin: 1rem 0 0;
  }

  /* COMMITTEE GRID */
  .committee-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  /* COMMITTEE CARDS */
  .committee-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: background 0.2s ease;
  }

  .committee-card:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  /* HEADING */
  .committee-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }

  .committee-heading h2 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    line-height: 1.3;
    margin: 0;
    color: #ffffff;
  }

  .head-chair {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
  }

  /* DIVIDER */
  .title-divider {
    width: 65px;
    height: 3px;
    background: #ffffff;
    margin: 1.5rem 0;
    border-radius: 5px;
  }

  /* TOPICS */
  .topic-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .topic-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .topic-number {
    font-size: 0.9rem;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.6);
    min-width: 25px;
  }

  .topic-name {
    font-size: 1.05rem;
    line-height: 1.5;
    color: #ffffff;
  }

  /* MOBILE */
  @media (max-width: 700px) {
    .topics-page {
      width: 90%;
      padding: 3rem 0 4rem;
    }

    .committee-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .committee-card {
      padding: 2rem 1.5rem;
    }

    .committee-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .page-intro h1 {
      font-size: 2rem;
    }
  }
</style>
</Layout>
