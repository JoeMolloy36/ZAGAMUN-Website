
---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "node:fs";

const csvText = readFileSync(
  "src/data/delegations.csv",
  "utf-8"
);

const lines = csvText.trim().split(/\r?\n/);

const delegations = lines
  .slice(1)
  .map((line) => {
    const [country, school] = line.split(",");

    return {
      country: country?.trim(),
      school: school?.trim()
    };
  })
  .filter((row) => row.country && row.school)
  .sort((a, b) => a.country.localeCompare(b.country));

// Group countries alphabetically by their first letter
const groupedDelegations = Object.entries(
  Object.groupBy(delegations, (item) => item.country[0].toUpperCase())
);
---

<Layout title="Delegations by School">

  <main class="delegations-page">

    <section class="page-intro">
      <span class="section-label">ZAGAMUN 2026</span>
      <h1>Delegations by School</h1>
      <p>
        Find your assigned school by locating your country's delegation below.
      </p>
    </section>

    <section class="delegations-grid">

      {groupedDelegations.map(([letter, countries]) => (
        <article class="letter-group">

          <h2>{letter}</h2>

          <div class="letter-divider"></div>

          <div class="delegation-list">
            {countries.map((delegation) => (
              <div class="delegation-row">
                <span class="country">{delegation.country}</span>
                <span class="school">{delegation.school}</span>
              </div>
            ))}
          </div>

        </article>
      ))}

    </section>

  </main>

</Layout>

<style>
  /* PAGE */
  .delegations-page {
    width: 90%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 5rem 0 6rem;
    color: #ffffff;
  }

  /* INTRODUCTION */
  .page-intro {
    margin-bottom: 2.5rem;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 3px;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .page-intro h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .page-intro p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #ffffff;
    margin: 1rem 0 0;
  }

  /* DELEGATION GRID */
  .delegations-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  /* LETTER GROUPS */
  .letter-group {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 1.75rem 2rem;
    transition: background 0.2s ease;
  }

  .letter-group:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  .letter-group h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 0;
    color: #ffffff;
  }

  .letter-divider {
    width: 45px;
    height: 3px;
    background: #ffffff;
    margin: 0.9rem 0 1.2rem;
    border-radius: 5px;
  }

  /* COUNTRY LIST */
  .delegation-list {
    display: flex;
    flex-direction: column;
  }

  .delegation-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .delegation-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .country {
    font-size: 0.95rem;
    font-weight: bold;
    color: #ffffff;
  }

  .school {
    font-size: 0.9rem;
    text-align: right;
    color: rgba(255, 255, 255, 0.75);
  }

  /* TABLET */
  @media (max-width: 950px) {
    .delegations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* MOBILE */
  @media (max-width: 650px) {
    .delegations-page {
      width: 90%;
      padding: 3rem 0 4rem;
    }

    .letter-group {
      padding: 1.5rem;
    }

    .page-intro h1 {
      font-size: 2rem;
    }

    .delegation-row {
      gap: 0.75rem;
    }

    .country,
    .school {
      font-size: 0.85rem;
    }
  }
</style>
