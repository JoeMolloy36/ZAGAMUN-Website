---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "node:fs";
import Papa from "papaparse";

const csvText = readFileSync(
  new URL("../data/delegations.csv", import.meta.url),
  "utf-8"
);

const parsed = Papa.parse(csvText, {
  header: true,
  skipEmptyLines: true,
  transformHeader: (header) => header.trim(),
  transform: (value) => value.trim()
});

const delegations = parsed.data
  .filter((row) => row.Country && row.School)
  .sort((a, b) => a.Country.localeCompare(b.Country));
---


<Layout title="Delegations by School">
  <main class="page-container">
    <h1>Delegations by School</h1>
    <p class="subtitle">
      View the assigned school for each country delegation.
    </p>

    <div class="delegation-list">
      {delegations.map((delegation) => (
        <div class="delegation-row">
          <span class="country">{delegation.country}</span>
          <span class="school">{delegation.school}</span>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .page-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    text-align: center;
    margin-bottom: 2.5rem;
    opacity: 0.75;
  }

  .delegation-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .delegation-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--card-bg);
    border: 2px solid var(--border-color);
    border-radius: 10px;
  }

  .country {
    font-weight: 700;
  }

  .school {
    text-align: right;
    opacity: 0.8;
  }

  @media (max-width: 500px) {
    .delegation-row {
      padding: 0.85rem;
    }
  }
</style>
