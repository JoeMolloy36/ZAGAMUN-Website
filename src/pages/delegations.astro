
---
import Layout from "../layouts/Layout.astro";
import { readFileSync } from "node:fs";

const csvText = readFileSync(
  "src/data/delegations.csv",
  "utf-8"
);

const lines = csvText.trim().split(/\r?\n/);

const delegations = lines
  .slice(1)
  .map((line) => {
    const [country, school] = line.split(",");

    return {
      country: country?.trim(),
      school: school?.trim()
    };
  })
  .filter((row) => row.country && row.school);
---

<Layout title="Delegations by School">

  <main class="delegations-page">

    <section class="page-intro">
      <span class="section-label">ZAGAMUN 2026</span>
      <h1>Delegations by School</h1>
      <p>
       View your schools allocated delegations below
      </p>
    </section>

    <div class="search-container">
  <input
    type="search"
    id="delegation-search"
    placeholder="Search countries or schools..."
    aria-label="Search countries or schools"
  />
</div>

    <section class="delegation-list">

      {delegations.map((delegation) => (
       <div
  class="delegation-row"
  data-country={delegation.country}
  data-school={delegation.school}
>
          <span class="country">{delegation.country}</span>
          <span class="school">{delegation.school}</span>
        </div>
      ))}

    </section>

  </main>

</Layout>

<style>
  /* PAGE */
  .delegations-page {
    width: 90%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 5rem 0 6rem;
    color: #ffffff;
  }

  /* INTRODUCTION */
  .page-intro {
    margin-bottom: 2.5rem;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 3px;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .page-intro h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .page-intro p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #ffffff;
    margin: 1rem 0 0;
  }

  /* DELEGATION LIST */
  .delegation-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* INDIVIDUAL ROWS */
  .delegation-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.5rem;

    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;

    transition: background 0.2s ease;
  }

  .delegation-row:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  .country {
    font-size: 1rem;
    font-weight: bold;
    color: #ffffff;
  }

  .school {
    font-size: 0.95rem;
    text-align: right;
    color: rgba(255, 255, 255, 0.8);
  }

  /* MOBILE */
  @media (max-width: 650px) {
    .delegations-page {
      width: 90%;
      padding: 3rem 0 4rem;
    }

    .delegation-row {
      padding: 1rem;
      gap: 0.75rem;
    }

    .country,
    .school {
      font-size: 0.85rem;
    }
  }

  .search-container {
  margin-bottom: 1.5rem;
}

.search-container input {
  width: 100%;
  box-sizing: border-box;
  padding: 1rem 1.25rem;

  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;

  color: #ffffff;
  font-family: inherit;
  font-size: 1rem;

  outline: none;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.search-container input::placeholder {
  color: rgba(255, 255, 255, 0.55);
}

.search-container input:focus {
  border-color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
}


</style>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "#delegation-search"
  );

  const delegationRows = document.querySelectorAll<HTMLElement>(
    ".delegation-row"
  );

  searchInput?.addEventListener("input", () => {
    const search = searchInput.value.toLowerCase().trim();

    delegationRows.forEach((row) => {
      const country = row.dataset.country?.toLowerCase() ?? "";
      const school = row.dataset.school?.toLowerCase() ?? "";

      const matches =
        country.includes(search) || school.includes(search);

      row.style.display = matches ? "flex" : "none";
    });
  });
</script>
