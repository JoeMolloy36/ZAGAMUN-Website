
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Schedule">

  <main class="schedule-page">

    <section class="page-intro">
      <h1>Conference Schedule</h1>
      <p>
        The schedule for ZAGAMUN 2026. We look forward to welcoming
        delegates on Friday 27th and Saturday 28th November.
      </p>
    </section>

    <section class="schedule-grid">

      <!-- FRIDAY -->
      <div class="day-box">
        <h2>Friday 27th</h2>

        <div class="schedule-item">
          <span class="time">4:30–5:00</span>
          <span class="event">Registration + Lobbying</span>
        </div>

        <div class="schedule-item">
          <span class="time">4:45</span>
          <span class="event">Co-Chair Meeting</span>
        </div>

        <div class="schedule-item">
          <span class="time">5:00–5:30</span>
          <span class="event">Opening Ceremony</span>
        </div>

        <div class="schedule-item">
          <span class="time">5:30–6:00</span>
          <span class="event">Dinner</span>
        </div>

        <div class="schedule-item">
          <span class="time">6:00–8:45</span>
          <span class="event">Committee</span>
        </div>

      </div>

      <!-- SATURDAY -->
      <div class="day-box">
        <h2>Saturday 28th</h2>

        <div class="schedule-item">
          <span class="time">9:00–12:30</span>
          <span class="event">Committee</span>
        </div>

        <div class="schedule-item">
          <span class="time">12:30–1:00</span>
          <span class="event">Lunch</span>
        </div>

        <div class="schedule-item">
          <span class="time">1:00–4:00</span>
          <span class="event">GA</span>
        </div>

        <div class="schedule-item">
          <span class="time">4:15–4:45</span>
          <span class="event">Closing Ceremony</span>
        </div>

      </div>

    </section>

  </main>

</Layout>

<style>

  .schedule-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 60px;
  }

  .page-intro {
    background: #e8eee9;
    color: #244638;
    border-radius: 20px;
    padding: 35px;
    margin-bottom: 30px;
    text-align: center;
  }

  .page-intro h1 {
    margin-top: 0;
    margin-bottom: 15px;
  }

  .page-intro p {
    max-width: 750px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
    align-items: stretch;
  }

  .day-box {
    background: #e8eee9;
    color: #244638;
    border-radius: 20px;
    padding: 30px;
  }

  .day-box h2 {
    text-align: center;
    margin-top: 0;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid #b6c8ba;
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 15px;
    align-items: center;
    padding: 18px 12px;
    border-bottom: 1px solid #b6c8ba;
    line-height: 1.5;
  }

  .schedule-item:last-child {
    border-bottom: none;
  }

  .time {
    font-weight: bold;
    white-space: nowrap;
  }

  .event {
    font-weight: 500;
  }

  @media (max-width: 750px) {

    .schedule-grid {
      grid-template-columns: 1fr;
    }

    .schedule-page {
      padding: 25px 15px 40px;
    }

    .day-box {
      padding: 20px;
    }

    .schedule-item {
      grid-template-columns: 105px 1fr;
      gap: 10px;
      padding: 16px 8px;
    }

    .page-intro {
      padding: 25px 20px;
    }

  }

</style>
