
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Crisis">
  <main class="crisis-page">
    <section class="intro">
      <p class="section-label">ZAGAMUN 2026</p>
      <h1>CRISIS!</h1>
      <div class="title-divider"></div>
    </section>

    <section class="crisis-card">
      <div class="crisis-section">
        <div class="pdf-container">
          <iframe
            src="/crisis-brief.pdf"
            title="Crisis Brief PDF"
          ></iframe>
        </div>

        <a
          href="/crisis-brief.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="pdf-link"
        >
          Open Crisis Brief
        </a>
      </div>

      <div class="crisis-section">
        <h2>Video</h2>
        <div class="card-divider"></div>

        <p>
          Watch the video briefing below for further context on the crisis.
        </p>

        <div class="video-container">
          <iframe
            src="https://www.youtube.com/embed/qC3FKg8sQvI"
            title="ZAGAMUN Crisis Briefing"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .crisis-page {
    width: 90%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 5rem 0 6rem;
    color: black;
  }

  .intro {
    margin-bottom: 3rem;
    text-align: center;
  }

  .section-label {
    font-size: 0.8rem;
    letter-spacing: 3px;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0;
  }

  .title-divider {
    width: 65px;
    height: 3px;
    background: white;
    border-radius: 5px;
    margin: 1.5rem auto;
  }

  .crisis-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 3rem;
    text-align: center;
  }

  .crisis-section {
    margin-bottom: 3.5rem;
  }

  .crisis-section:last-child {
    margin-bottom: 0;
  }

  .crisis-card h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0;
  }

  .card-divider {
    width: 65px;
    height: 3px;
    background: white;
    border-radius: 5px;
    margin: 1.5rem auto;
  }

  .crisis-card p {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .pdf-container {
    width: 100%;
    height: 600px;
    overflow: hidden;
    border-radius: 12px;
    margin-top: 1.5rem;
    background: white;
  }

  .pdf-container iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: white;
  }

  .pdf-link {
    display: inline-block;
    margin-top: 1rem;
    color: #c5d9ce;
    text-decoration: underline;
  }

  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    margin-top: 1.5rem;
  }

  .video-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 700px) {
    .crisis-page {
      padding: 3rem 0 4rem;
    }

    .crisis-card {
      padding: 2rem 1.5rem;
    }

    .crisis-section {
      margin-bottom: 2.5rem;
    }

    .pdf-container {
      height: 500px;
    }
  }
</style>
