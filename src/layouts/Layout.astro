
---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#244638" />

    <title>{title} | ZAGAMUN</title>

    <meta
      name="description"
      content="ZAGAMUN is the Gonzaga College Model United Nations conference bringing together delegates across Dublin to debate global issues."
    />

    <meta
      name="keywords"
      content="ZAGAMUN, Gonzaga MUN, Model United Nations, MUN, student conference, diplomacy, debate, international relations"
    />
  </head>

  <body>
    <header>
      <a class="logo" href="/">
  <img src="/IMG_0684.png" alt="ZAGAMUN Logo" class="logo-image" />
  <span>ZAGAMUN</span>
</a>

      

      <nav>
        <!-- Home -->
        <a href="/">Home</a>

        <!-- 2026 Conference dropdown -->
        <details class="nav-dropdown">
          <summary>2026 Conference</summary>

          <div class="dropdown-menu">
            <a href="/topics">Committee Topics</a>
            <a href="/chairs">Committee Chairs</a>
            <a href="/team">ZAGAMUN Team</a>
            <a href="/schedule">Schedule</a>
            <a href="/delegations">Delegations</a>

          </div>
        </details>

        <!-- General Information dropdown -->
        <details class="nav-dropdown">
          <summary>General Info</summary>

          <div class="dropdown-menu">
            <a href="/about">About ZAGAMUN</a>
            <a href="/awards">Award Criteria</a>
            <a href="/rules">Rules and Procedures</a>
          </div>
        </details>

        <!-- External Resolutions link -->
        <a
          href="YOUR_RESOLUTIONS_URL"
          target="_blank"
          rel="noopener noreferrer"
        >
          Resolutions
        </a>
      </nav>
    </header>

    <slot />

    <footer>
      <p>© ZAGAMUN 2026 · Gonzaga Model United Nations Conference.</p>
    </footer>
  </body>
</html>

<style is:global>
  /* ========================================
     DESIGN SETTINGS
     ======================================== */

  :root {
    /* Colour palette */
    --page-bg: #248b46;
    --header-bg: #005b32;
    --footer-bg: #005b32;

    --text-color: #005b32;
    --muted-color: #dce6dc;

    --accent-color: #78977c;
    --accent-hover: #a9c4a4;
    --border-color: #3e6850;

    /* Typography */
    --logo-size: 1.35rem;
    --nav-size: 1.35rem;
    --button-size: 1.25rem;
    --footer-size: 1rem;

    /* Spacing */
    --header-padding: 1.6rem 5%;
    --nav-gap: 2rem;
    --button-padding: 0.7rem 1.3rem;

    /* General */
    --content-width: 1200px;
    --border-radius: 8px;

    font-family: "Arialll", sans-serif;
    font-weight: bold;
    color: var(--text-color);
    background: var(--page-bg);
    font-synthesis: none;
  }

  /* ========================================
     CUSTOM FONT
     ======================================== */

  @font-face {
    font-family: "Arialll";
    src: url("/fonts/Arialll.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* ========================================
     GLOBAL STYLES
     ======================================== */

  * {
    box-sizing: border-box;
  }



  html {
    min-height: 100%;
    background: var(--page-bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--page-bg);
    color: var(--text-color);
    font-family: "Arialll", sans-serif;
    font-weight: bold;
    -webkit-text-stroke: 0.3px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  body > main {
    flex: 1;
  }

  /* ========================================
     HEADER
     ======================================== */

  header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;

  padding: var(--header-padding);

  background: var(--header-bg);
  border-bottom: 3px solid var(--border-color);

  /* Sticky header */
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
}

  /* Website title */

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: var(--logo-size);
  font-weight: 800;
  letter-spacing: 2px;
  white-space: nowrap;
  color: #ffffff;
}

.logo-image {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

  /* ========================================
     NAVIGATION
     ======================================== */

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nav-gap);
    align-items: center;
  }

  nav a,
  .nav-dropdown summary {
    font-size: var(--nav-size);
    color: #ffffff;
    transition: color 0.2s ease;
  }

  nav a:hover,
  .nav-dropdown summary:hover {
    color: var(--accent-hover);
  }

  /* Dropdown container */

  .nav-dropdown {
    position: relative;
    cursor: pointer;
  }

  /* Dropdown heading */

  .nav-dropdown summary {
    list-style: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown summary::after {
    content: " ▾";
    font-size: 0.85em;
  }

  /* Dropdown menu */

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;

    min-width: 210px;
    padding: 0.5rem 0;

    background: #005b32;
    border: 1px solid #3e6850;
    border-radius: 8px;

    display: none;
    flex-direction: column;
    gap: 0;

    z-index: 100;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  /* Show dropdown when opened */

  .nav-dropdown[open] .dropdown-menu {
    display: flex;
  }

  /* Dropdown links */

  .dropdown-menu a {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: #174d36;
    color: #a9c4a4;
  }

  /* Keyboard accessibility */

  nav a:focus-visible,
  .nav-dropdown summary:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 4px;
  }

  /* ========================================
     FOOTER
     ======================================== */

  footer {
    margin-top: auto;
    width: 100%;

    text-align: center;
    padding: 1.6rem;

    background: var(--footer-bg);
    color: #dce6dc;

    border-top: 3px solid var(--border-color);
    font-size: var(--footer-size);
  }

  footer p {
    margin: 0;
  }

  /* ========================================
     MOBILE RESPONSIVENESS
     ======================================== */

  @media (max-width: 600px) {
    header {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
    }

    .logo {
      font-size: 1.8rem;
    }

    .logo-image {
  width: 38px;
  height: 38px;
}


    nav {
      justify-content: center;
      gap: 1rem;
    }

    nav a,
    .nav-dropdown summary {
      font-size: 1.1rem;
    }

    .nav-dropdown {
      position: relative;
    }

    .dropdown-menu {
      left: 50%;
      transform: translateX(-50%);
      min-width: 190px;
    }

    .dropdown-menu a {
      font-size: 1rem;
    }

    footer {
      padding: 1.2rem 0.75rem;
      font-size: 0.9rem;
    }
  }

  /* ========================================
     REDUCED MOTION ACCESSIBILITY
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
