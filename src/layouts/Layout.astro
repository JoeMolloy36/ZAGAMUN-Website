
---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="theme-color" content="#244638" />
    
    <title>{title} | ZAGAMUN</title>

    <meta
      name="description"
      content="ZAGAMUN is a the Gonzaga College Model United Nations conference bringing together delegates across Dublin to debate global issues"
    />

    <meta
      name="keywords"
      content="ZAGAMUN, Gonzaga MUN, Model United Nations, MUN, student conference, diplomacy, debate, international relations"
    />

  </head>

  <body>
    <header>
      <a class="logo" href="/">
        <span>ZAGAMUN</span>
      </a>

      <nav>
        <a href="/about">About</a>
        <a href="/topics">Committee Topics</a>
        <a href="/topics">Head Chairs</a>
        <a href="/schedule">Schedule</a>
      </nav>
    </header>

    <slot />

    <footer>
      <p>© 2026 ZAGAMUN · Gonzaga Model United Nations Conference.</p>
    </footer>
  </body>
</html>

<style is:global>
  /* ========================================
     DESIGN SETTINGS
     ======================================== */

  :root {
    /* Colour palette */
    --page-bg: #248b46;
    --header-bg: #005b32;
    --footer-bg: #005b32;

    --text-color: #005b32;
    --muted-color: #dce6dc;

    --accent-color: #78977c;
    --accent-hover: #a9c4a4;
    --border-color: #3e6850;

    /* Typography */
    --logo-size: 1.35rem;
    --nav-size: 1.35rem;
    --button-size: 1.25rem;
    --footer-size: 1rem;

    /* Spacing */
    --header-padding: 1.5rem 5%;
    --nav-gap: 2rem;
    --button-padding: 0.7rem 1.3rem;

    /* General */
    --content-width: 1200px;
    --border-radius: 8px;

    font-family: "m5x7", sans-serif;
    font-weight: bold;
    color: var(--text-color);
    background: var(--page-bg);
    font-synthesis: none;
  }

  /* ========================================
     CUSTOM FONT
     ======================================== */

  @font-face {
    font-family: "m5x7";
    src: url("/fonts/Arial.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* ========================================
     GLOBAL STYLES
     ======================================== */

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--page-bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--page-bg);
    color: var(--text-color);
    font-family: "Arial", sans-serif;
    font-weight: bold;
    -webkit-text-stroke: 0.3px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  body > main {
    flex: 1;
  }

  /* ========================================
     HEADER
     ======================================== */

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;

    padding: var(--header-padding);

    background: var(--header-bg);
    border-bottom: 3px solid var(--border-color);
  }

  /* Website title */

  .logo {
    display: flex;
    align-items: center;
    font-size: var(--logo-size);
    font-weight: 800;
    letter-spacing: 2px;
    white-space: nowrap;
    color: #ffffff;
  }

  /* Navigation */

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nav-gap);
    align-items: center;
  }

  nav a {
    font-size: var(--nav-size);
    color: #ffffff;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--accent-hover);
  }

  /* ========================================
     REGISTER BUTTON
     ======================================== */

  .nav-button {
    display: inline-block;

    background: var(--accent-color);
    color: #ffffff;

    padding: var(--button-padding);
    border-radius: var(--border-radius);

    font-size: var(--button-size);
    font-weight: 700;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .nav-button:hover {
    background: var(--accent-hover);
    color: var(--header-bg);
    transform: translateY(-2px);
  }

  .nav-button:active {
    transform: translateY(0);
  }

  /* Keyboard accessibility */

  a:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 4px;
  }

  /* ========================================
     FOOTER
     ======================================== */

  footer {
    margin-top: auto;
    width: 100%;

    text-align: center;
    padding: 1.5rem;

    background: var(--footer-bg);
    color: #dce6dc;

    border-top: 3px solid var(--border-color);
    font-size: var(--footer-size);
  }

  footer p {
    margin: 0;
  }

  /* ========================================
     MOBILE RESPONSIVENESS
     ======================================== */

  @media (max-width: 600px) {
    header {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
    }

    .logo {
      font-size: 1.8rem;
    }

    nav {
      justify-content: center;
      gap: 1rem;
    }

    nav a {
      font-size: 1.1rem;
    }

    .nav-button {
      padding: 0.6rem 0.9rem;
      font-size: 1.1rem;
    }

    footer {
      padding: 1.2rem 0.75rem;
      font-size: 0.9rem;
    }
  }

  /* ========================================
     REDUCED MOTION ACCESSIBILITY
     ======================================== */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
